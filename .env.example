# ==============================================================================
# Cerevyn PS09: Adaptive Memory Match — Environment Configuration
# ==============================================================================
# The core browser application runs entirely client-side with zero required
# runtime environment variables, external API keys, or paid service dependencies.
# ==============================================================================

# Optional: Port configuration for local Vite development server (default: 5173)
VITE_PORT=5173

# Optional: Base URL path if hosting in a subpath (default: /)
VITE_BASE_URL=/

# Optional: Cloud deployment reference token (configured in GitHub Secrets, NEVER committed)
# AZURE_STATIC_WEB_APPS_API_TOKEN=your-azure-static-web-apps-api-token-here
